{% assign repo_url = include.repository | split: '/' %}
{% if site.data.repositories.github_users contains repo_url.first %}
  {% assign show_owner = false %}
{% else %}
  {% assign show_owner = true %}
{% endif %}

{% if site.data.repositories.repo_description_lines_max %}
  {% assign max_lines = site.data.repositories.repo_description_lines_max %}
{% else %}
  {% assign max_lines = 2 %}
{% endif %}

{% assign stats = site.data.repo_stats[include.repository] %}

<div class="repo p-2">
  <a class="repo-card" href="https://github.com/{{ include.repository }}">
    <div class="repo-card-title">
      <i class="fa-brands fa-github"></i>
      {% if show_owner %}{{ include.repository }}{% else %}{{ repo_url[1] }}{% endif %}
    </div>
    {% if stats.description and stats.description != '' %}
      <p class="repo-card-description" style="-webkit-line-clamp: {{ max_lines }};">{{ stats.description | escape }}</p>
    {% endif %}
    <div class="repo-card-meta">
      {% if stats.language and stats.language != '' %}
        <span><span class="repo-card-lang-dot"></span>{{ stats.language }}</span>
      {% endif %}
      {% if stats %}
        <span><i class="fa-regular fa-star"></i> {{ stats.stars }}</span>
        <span><i class="fa-solid fa-code-fork"></i> {{ stats.forks }}</span>
      {% endif %}
    </div>
  </a>
</div>
